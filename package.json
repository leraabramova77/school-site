{
  "name": "school-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/run-on-free-port.ts dev",
    "start": "tsx scripts/run-on-free-port.ts start",
    "build": "next build",
    "lint": "biome check",
    "lint:fsd": "steiger ./src",
    "format": "biome format --write",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm lint && pnpm lint:env && pnpm lint:fsd && pnpm typecheck && pnpm test",
    "wt": "tsx scripts/worktree.ts",
    "hooks:install": "git config core.hooksPath scripts/hooks",
    "lint:env": "tsx scripts/check-public-env.ts",
    "test:e2e": "playwright test",
    "netschool:watch": "tsx scripts/netschool-session-watch.ts",
    "demo": "tsx scripts/demo.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@tanstack/react-query": "5.104.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "iron-session": "9.0.1",
    "lucide-react": "1.61.0",
    "motion": "14.5.0",
    "next": "16.4.2",
    "next-themes": "0.4.6",
    "node-html-parser": "9.0.5",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "sanitize-html": "2.18.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@feature-sliced/steiger-plugin": "^0.8.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "2.16.2",
    "steiger": "^0.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  }
}
